# Ignore everything at root
/*

# Whitelist allowed directories & files
!/.gitignore
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
!/CHANGELOG.md
!/SUPPORT.md
!/ACCESSIBILITY.md
!/docs/
!/.github/
!/AETHER-rust/
!/AETHER-swift/
!/AETHER-web/

# Standard build & secret ignores
AETHER-rust/target/
AETHER-rust/dist/
AETHER-swift/.build/
AETHER-swift/dist/
AETHER-web/node_modules/
AETHER-web/dist/
AETHER-web/data/
AETHER-web/.env
AETHER-web/.env.local
AETHER-web/.env.*.local
.DS_Store
agent.md
auto_sync.sh
